rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Fonction utilitaire pour vérifier si l'utilisateur est admin en lisant Firestore
    function isAdmin() {
      return request.auth != null && 
             firestore.exists(/databases/(default)/documents/users/$(request.auth.uid)) &&
             firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // ==========================================
    // TRAIL ROADBOOK PRO
    // ==========================================
    match /official_traces/{allPaths=**} {
      // Tout utilisateur connecté peut télécharger une trace officielle
      allow read: if request.auth != null;
      
      // Seul un admin peut uploader, modifier ou supprimer une trace
      allow write: if request.auth != null && isAdmin();
    }
    
    // ==========================================
    // PLAN BUILDER
    // ==========================================
    match /coaches/{coachId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == coachId;
    }

    // ==========================================
    // AUTRES FICHIERS (COMMUN)
    // ==========================================
    match /{allPaths=**} {
      // Les utilisateurs authentifiés peuvent lire et écrire leurs propres fichiers
      // (À adapter selon les besoins de votre app)
      allow read, write: if request.auth != null;
    }
  }
}
