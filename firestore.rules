rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Fonction utilitaire pour vérifier si l'utilisateur est admin
    function isAdmin() {
      let userRef = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(userRef) && get(userRef).data.get('role', '') == 'admin';
    }
    
    // ==========================================
    // TRAIL ROADBOOK PRO
    // ==========================================
    
    match /users/{userId} {
      // Tout utilisateur connecté peut chercher un utilisateur (par exemple, par email pour partager un roadbook)
      allow read: if request.auth != null;
      
      // Un utilisateur ne peut modifier que son propre profil
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /roadbooks/{roadbookId} {
      // Lecture : l'utilisateur doit être connecté OU le roadbook est partagé publiquement
      allow read: if request.auth != null || resource.data.get('isPublic', false) == true || resource.data.get('shared', false) == true;
      
      // Création : l'utilisateur doit être le propriétaire du roadbook qu'il crée
      allow create: if request.auth != null && request.auth.uid == request.resource.data.userId;
      
      // Mise à jour / Suppression : doit être le propriétaire OU un administrateur
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        isAdmin()
      );
    }

    match /official_traces/{traceId} {
      // Tout utilisateur connecté peut lire les traces officielles
      allow read: if request.auth != null;
      
      // Seul un admin peut créer, modifier ou supprimer des traces officielles
      allow write: if request.auth != null && isAdmin();
    }

    match /nutrition_products/{productId} {
      // Tout utilisateur connecté peut lire les produits nutrition
      allow read: if request.auth != null;
      
      // Création : soit un utilisateur crée un produit personnel, soit un admin crée un produit officiel
      allow create: if request.auth != null && (
        request.auth.uid == request.resource.data.userId || 
        isAdmin()
      );
      
      // Modification / Suppression : doit être le propriétaire du produit (produit perso) OU un admin (produits officiels)
      allow update, delete: if request.auth != null && (
        request.auth.uid == resource.data.userId || 
        isAdmin()
      );
    }
    
    // ==========================================
    // PLAN BUILDER
    // ==========================================
    
    // Bibliothèque globale de modèles de séances
    match /workout_templates/{templateId} {
      allow read: if request.auth != null;
      // Optionnel : allow write: if isAdmin();
    }

    match /coaches/{coachId} {
      // Accès à l'espace Coaching : strictement réservé à un administrateur sur son propre compte
      allow read, write: if request.auth != null && request.auth.uid == coachId && isAdmin();
      
      // Accès aux sous-collections (athlètes, plans, templates)
      match /athletes/{athleteId} {
        allow read, write: if request.auth != null && request.auth.uid == coachId && isAdmin();
        
        match /plans/{planId} {
          allow read, write: if request.auth != null && request.auth.uid == coachId && isAdmin();
        }
      }
      
      match /templates/{templateId} {
        allow read, write: if request.auth != null && request.auth.uid == coachId && isAdmin();
      }
    }
  }
}
