{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["PLAN_BUILDER_URL", "NEXT_PUBLIC_PLAN_BUILDER_URL"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {
      "dependsOn": ["^lint"]
    }
  }
}
